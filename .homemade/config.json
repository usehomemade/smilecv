{
  "$schema": "https://homemade.dev/schemas/latest/config.json",
  "install": [
    "pnpm config set //npm.hugeicons.com/:_authToken \"$HUGEICONS_TOKEN\" --location=global",
    "pnpm install --frozen-lockfile",
    "[ -f src/paraglide/messages.js ] || pnpm exec paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie custom-html preferredLanguage baseLocale --silent"
  ],
  "services": {
    "db": {
      "cmd": "docker start -a smilepg || docker run --name smilepg -e POSTGRES_USER=smilecv -e POSTGRES_PASSWORD=smilecv -e POSTGRES_DB=smilecv -p 54329:5432 postgres:17",
      "port": 54329,
      "healthcheck": {
        "cmd": "docker exec smilepg pg_isready -U smilecv -h 127.0.0.1 -q"
      },
      "displayName": "Postgres"
    },
    "web": {
      "cmd": "pnpm db:migrate && exec pnpm dev --host 0.0.0.0 --port \"$PORT\" --strictPort",
      "port": 3033,
      "url": true,
      "depends_on": {
        "db": {
          "condition": "healthy"
        }
      },
      "healthcheck": {
        "path": "/api/health"
      }
    }
  },
  "env_schema": [
    {
      "key": "HUGEICONS_TOKEN",
      "warmup": true
    },
    "DATABASE_URL",
    "BETTER_AUTH_URL",
    {
      "key": "BETTER_AUTH_SECRET",
      "generate": true
    },
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "R2_ACCOUNT_ID",
    "R2_BUCKET",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "USESEND_API_KEY",
    "USESEND_URL",
    "EMAIL_FROM",
    "ADMIN_EMAILS",
    "UMAMI_WEBSITE_ID",
    "UMAMI_SCRIPT_URL",
    "INTERNAL_URL",
    "SOURCE_COMMIT",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_EXPORTER_OTLP_HEADERS"
  ],
  "warmup": [
    "pnpm config set //npm.hugeicons.com/:_authToken \"$HUGEICONS_TOKEN\" --location=global",
    "pnpm install --frozen-lockfile",
    "pnpm exec paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie custom-html preferredLanguage baseLocale --silent",
    "docker pull postgres:17"
  ]
}
