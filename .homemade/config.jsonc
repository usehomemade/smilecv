// Generated by Project Doctor
{
  "$schema": "https://www.homemade.dev/schemas/latest/config.json",
  // Hugeicons Pro is a private registry: HUGEICONS_TOKEN (project env) is
  // written to pnpm's user config before every install.
  "warmup": [
    "[ -z \"$HUGEICONS_TOKEN\" ] || pnpm config set //npm.hugeicons.com/:_authToken \"$HUGEICONS_TOKEN\" --location=global",
    "pnpm install --frozen-lockfile",
    "docker pull postgres:17"
  ],
  "install": [
    "[ -z \"$HUGEICONS_TOKEN\" ] || pnpm config set //npm.hugeicons.com/:_authToken \"$HUGEICONS_TOKEN\" --location=global",
    "pnpm install --frozen-lockfile",
    // Git-ignored outputs the dev server needs before it starts.
    "node scripts/brand.mjs",
    "pnpm exec paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie custom-html preferredLanguage baseLocale --silent"
  ],
  "services": {
    "db": {
      "cmd": "docker start -a smilepg || docker run --name smilepg -e POSTGRES_USER=smilecv -e POSTGRES_PASSWORD=smilecv -e POSTGRES_DB=smilecv -p 54329:5432 postgres:17",
      "port": 54329,
      "healthcheck": { "cmd": "docker exec smilepg pg_isready -U smilecv -h 127.0.0.1 -q" },
      "displayName": "Postgres"
    },
    "web": {
      "cmd": "pnpm db:migrate && exec pnpm exec vite dev --host 0.0.0.0 --port $PORT",
      "depends_on": { "db": { "condition": "healthy" } },
      "port": 3033,
      "url": true,
      "healthcheck": { "path": "/api/health" },
      "displayName": "SmileCV"
    }
  },
  "env_schema": [
    { "key": "HUGEICONS_TOKEN", "warmup": true },
    { "key": "DATABASE_URL", "default": "postgresql://smilecv:smilecv@127.0.0.1:54329/smilecv" },
    { "key": "BETTER_AUTH_URL", "default": "${HOMEMADE_URL_3033}" },
    { "key": "BETTER_AUTH_SECRET", "generate": true },
    { "key": "OPENAI_MODEL", "default": "gpt-5.4-mini" },
    "OPENAI_API_KEY",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "R2_ACCOUNT_ID",
    "R2_BUCKET",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY"
  ]
}
